# Python build / cache artifacts. The plugin tree itself is declarative
# config + rendered skills, but the dev/test harness (uv + pytest +
# editable guide-cli) emits these.
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Reserved for forward-compat. Today no operator state lives under the
# plugin tree (unlike the Hermes plugin's `.local/`), but if a future
# release adds per-project state, this is where it goes.
.local/

# build artifacts
dist/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# bd takes this lock in the HIVE ROOT, not under .beads/, so it dirties the main clone — and
# `bh work merge` refuses to merge a dirty main clone. Untracked, that makes every merge in
# this hive fail on a lock file the merge itself just created. Regenerable; never commit it.
.beads.gate.lock

# Beads working copy / exports — no issue data on GitHub
.beads/*.jsonl
